<http://purl.obolibrary.org/obo/aism/serial-position.owl>
    a owl:Ontology ;
    rdfs:label "New AISM serial position quality subclasses" .

### serial position notation (AnnotationProperty)
obo:AISM_0000637 a owl:AnnotationProperty ;
    rdfs:label "serial position notation"@en ;
    dc:creator "starasov https://orcid.org/0000-0001-5237-2330" ;
    oboInOwl:creation_date "2026-05-16" .

### serial position quality
obo:AISM_0000636 a owl:Class ;
    rdfs:label "serial position quality"@en ;
    dc:creator "starasov https://orcid.org/0000-0001-5237-2330" ;
    oboInOwl:creation_date "2026-05-16" ;
    obo:IAO_0000115 "A relational quality inhering in an entity by virtue of the entity's position within a repeated series of similar entities."@en ;
    rdfs:subClassOf obo:PATO_0000001 .

